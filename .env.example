# Copy this file to .env and fill in your key.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model (use one that has a free tier available on your account)
GEMINI_MODEL=gemini-2.5-flash

# High-level goal for the agent
AGENT_GOAL=Survive in Rookgaard, hunt weak creatures and level up.

# Seconds between LLM calls. The free tier limits requests per minute (RPM);
# 8s is about 7-8 RPM, which usually stays under the limit.
PLANNER_INTERVAL=8

# WebSocket bridge between the agent (server) and OTClient / mock (client)
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765

# Reflex layer
HEAL_HP_PCT=50
HEAL_SPELL=exura
HEAL_MANA_COST=20
HEAL_COOLDOWN=1.0

# Folder where memory and per-run logs are stored
RUNS_DIR=runs
