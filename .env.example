# Copia este archivo a .env y rellena tu clave.
# Clave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo de Gemini (usa uno con capa gratuita disponible en tu cuenta)
GEMINI_MODEL=gemini-2.5-flash

# Objetivo de alto nivel para el agente
AGENT_GOAL=Sobrevive en Rookgaard, caza criaturas débiles y sube de nivel.

# Segundos entre llamadas al LLM. La capa gratuita limita las peticiones por
# minuto (RPM); 8s ≈ 7-8 RPM, suele quedar por debajo del límite.
PLANNER_INTERVAL=8

# Puente WebSocket entre el agente (servidor) y OTClient / mock (cliente)
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765

# Capa de reflejos
HEAL_HP_PCT=50
HEAL_SPELL=exura
HEAL_MANA_COST=20
HEAL_COOLDOWN=1.0

# Carpeta donde se guardan memoria y logs de cada ejecución
RUNS_DIR=runs
