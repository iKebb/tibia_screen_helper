Module
  name: tibia_bridge
  description: WebSocket bridge between OTClient and the AI agent (tibia_agent)
  author: tibia_screen_helper
  website: https://github.com/iKebb/tibia_screen_helper
  autoload: true
  autoload-priority: 1000
  sandboxed: true
  scripts: [ bridge ]
  @onLoad: init()
  @onUnload: terminate()
